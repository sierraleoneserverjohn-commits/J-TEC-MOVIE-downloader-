# ==============================================================================
# JTEC MOVIES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / GitHub Pages / Android Capacitor)
# ------------------------------------------------------------------------------
# Deployed Render backend URL (e.g., https://jtec-movies-api.onrender.com)
# Leave empty or unset in local development to fallback to embedded mock data.
VITE_API_BASE_URL="https://jtec-movies-api.onrender.com"

# Optional base path for GitHub Pages project subpaths (e.g., /jtec-movies/)
# Defaults to './' if not set.
VITE_BASE_PATH="./"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Service / Node.js)
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production')
NODE_ENV="production"

# Port on which the Express server listens (Render automatically sets this)
PORT=10000

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# e.g., https://yourusername.github.io,https://localhost,capacitor://localhost
FRONTEND_URL="https://yourusername.github.io,capacitor://localhost,http://localhost:3000"

# Upstash Redis REST API credentials (from https://console.upstash.com)
# Obtain from Upstash Console -> Database -> Details -> REST API
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX...your_upstash_rest_token_here..."

# Cache TTL in seconds (default: 3600 = 1 hour)
REDIS_CACHE_TTL_SECONDS=3600

# Rate limit maximum requests per window per IP (default: 120 requests per minute)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
