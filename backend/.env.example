# Environment Mode
NODE_ENV=production

# Server Port (Render injects PORT automatically)
PORT=10000

# Allowed Frontend Origins for CORS (comma separated)
FRONTEND_URL=https://yourusername.github.io,capacitor://localhost,https://localhost,http://localhost:3000

# Upstash Redis REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Redis Cache TTL (seconds)
REDIS_CACHE_TTL_SECONDS=3600

# Rate Limiter
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
